{
  "name": "travel-platform-api",
  "version": "0.0.1",
  "private": true,
  "description": "This project is API for travel journal",
  "license": "UNLICENSED",
  "author": "Vitaliy Rudakovskiy",
  "imports": {
    "#prisma": {
      "types": "./prisma/generated/index.d.ts",
      "default": "./prisma/generated/index.js"
    },
    "#auth-prisma": {
      "types": "./apps/auth-service/prisma/generated/index.d.ts",
      "default": "./apps/auth-service/prisma/generated/index.js"
    },
    "#booking-prisma": {
      "types": "./apps/booking-service/prisma/generated/index.d.ts",
      "default": "./apps/booking-service/prisma/generated/index.js"
    },
    "#notify-prisma": {
      "types": "./apps/notification-service/prisma/generated/index.d.ts",
      "default": "./apps/notification-service/prisma/generated/index.js"
    }
  },
  "scripts": {
    "start": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/travel-platform-api/apps/travel-platform-api/src/main",
    "start:gateway": "nest start api-gateway --watch",
    "start:auth": "nest start auth-service --watch",
    "start:catalog": "nest start catalog-service --watch",
    "start:booking": "nest start booking-service --watch",
    "start:notification": "nest start notification-service --watch",
    "build": "nest build --all",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:int": "vitest run --config vitest.integration.config.mjs",
    "prepare": "husky",
    "migration": "npx prisma migrate dev --name ANY_NAME",
    "prisma:ui": "npx prisma studio",
    "prisma:generate": "npx prisma generate",
    "prisma:generate:auth": "prisma generate --config apps/auth-service/prisma.config.ts",
    "migrate:auth": "prisma migrate dev --config apps/auth-service/prisma.config.ts",
    "migrate:deploy:auth": "prisma migrate deploy --config apps/auth-service/prisma.config.ts",
    "seed:auth": "prisma db seed --config apps/auth-service/prisma.config.ts",
    "studio:auth": "prisma studio --config apps/auth-service/prisma.config.ts --port 5561",
    "migration:generate:catalog": "tsx ./node_modules/typeorm/cli.js migration:generate -d apps/catalog-service/src/database/data-source.ts",
    "migration:run:catalog": "tsx ./node_modules/typeorm/cli.js migration:run -d apps/catalog-service/src/database/data-source.ts",
    "migration:revert:catalog": "tsx ./node_modules/typeorm/cli.js migration:revert -d apps/catalog-service/src/database/data-source.ts",
    "seed:catalog": "tsx apps/catalog-service/src/database/seed.ts",
    "prisma:generate:booking": "prisma generate --config apps/booking-service/prisma.config.ts",
    "migrate:booking": "prisma migrate dev --config apps/booking-service/prisma.config.ts",
    "migrate:deploy:booking": "prisma migrate deploy --config apps/booking-service/prisma.config.ts",
    "studio:booking": "prisma studio --config apps/booking-service/prisma.config.ts --port 5563",
    "prisma:generate:notify": "prisma generate --config apps/notification-service/prisma.config.ts",
    "migrate:notify": "prisma migrate dev --config apps/notification-service/prisma.config.ts",
    "migrate:deploy:notify": "prisma migrate deploy --config apps/notification-service/prisma.config.ts",
    "studio:notify": "prisma studio --config apps/notification-service/prisma.config.ts --port 5564"
  },
  "dependencies": {
    "@golevelup/nestjs-rabbitmq": "9.1.2",
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/microservices": "11.1.29",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^12.0.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11.0.3",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/client-runtime-utils": "7.9.1",
    "axios": "^1.21.1",
    "bcrypt": "^6.0.0",
    "dotenv": "17.4.2",
    "ioredis": "^5.11.1",
    "nodemailer": "^10.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.31",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "prisma": "^7.9.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-loader": "^9.5.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,js,mjs,json}": [
      "oxfmt"
    ]
  }
}
