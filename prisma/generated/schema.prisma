generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

model Booking {
  id              String           @id @default(uuid())
  userId          String           @map("user_id")
  offerId         String           @map("offer_id")
  startDate       DateTime         @map("start_date")
  endDate         DateTime         @map("end_date")
  guestsCount     Int              @map("guests_count")
  totalPrice      Decimal          @map("total_price") @db.Decimal(10, 2)
  status          BookingStatus    @default(pending)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  idempotencyKeys IdempotencyKey[]
  notifications   Notification[]
  offer           Offer            @relation(fields: [offerId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([offerId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("bookings")
}

enum BookingStatus {
  pending
  confirmed
  completed
  cancelled
}

model ClientProfile {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id")
  firstName         String?  @map("first_name") @db.VarChar(50)
  lastName          String?  @map("last_name") @db.VarChar(50)
  phone             String?  @db.VarChar(30)
  preferredCurrency Currency @default(BYN) @map("preferred_currency")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

model Destination {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(50)
  countryCode String   @map("country_code") @db.VarChar(2)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  offers      Offer[]

  // Индексы
  @@index([name])
  @@index([countryCode])
  @@map("destinations")
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("email_verifications")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  offerId   String   @map("offer_id")
  createdAt DateTime @default(now()) @map("created_at")
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, offerId])
  @@index([userId])
  @@index([offerId])
  @@map("favorites")
}

model IdempotencyKey {
  id          String   @id @default(uuid())
  key         String
  requestHash String   @map("request_hash")
  userId      String   @map("user_id")
  bookingId   String?  @map("booking_id")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

enum NotificationType {
  booking_confirmed
  booking_cancelled
  booking_completed
  email_verification
}

enum NotificationChannel {
  email
  in_app
}

enum NotificationStatus {
  pending
  sent
  failed
}

model Notification {
  id           String              @id @default(uuid())
  userId       String              @map("user_id")
  type         NotificationType
  channel      NotificationChannel
  payload      Json
  status       NotificationStatus  @default(pending)
  errorMessage String?             @map("error_message")
  createdAt    DateTime            @default(now()) @map("created_at")
  sentAt       DateTime?           @map("sent_at")
  bookingId    String?             @map("booking_id")
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking      Booking?            @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookingId])
  @@index([status])
  @@index([type])
  @@map("notifications")
}

model Offer {
  id                    String      @id @default(uuid())
  type                  OfferType
  destinationId         String      @map("destination_id")
  ownerId               String      @map("owner_id")
  title                 String      @db.VarChar(100)
  description           String?
  price                 Decimal     @db.Decimal(7, 2)
  currency              Currency
  maxGuests             Int         @default(1) @map("max_guests")
  maxConcurrentBookings Int         @default(1) @map("max_concurrent_bookings")
  availableFrom         DateTime    @map("available_from")
  availableTo           DateTime    @map("available_to")
  status                OfferStatus @default(active)
  stars                 Int?
  address               String?     @db.VarChar(100)
  flightNumber          String?     @map("flight_number") @db.VarChar(25)
  airline               String?     @db.VarChar(100)
  durationDays          Int?        @map("duration_days")
  includesMeals         Boolean?    @map("includes_meals")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  deletedAt             DateTime?   @map("deleted_at")
  bookings              Booking[]
  favorites             Favorite[]
  destination           Destination @relation(fields: [destinationId], references: [id])
  user                  User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([destinationId])
  @@index([ownerId])
  @@index([type])
  @@index([status])
  @@index([availableFrom, availableTo])
  @@map("offers")
}

enum OfferType {
  hotel
  flight
  tour
}

enum Currency {
  BYN
  USD
  EUR
}

enum OfferStatus {
  active
  archived
}

model UserSession {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  refreshTokenHash String   @unique @map("refresh_token_hash")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

enum UserRole {
  Admin
  Agent
  User
}

model User {
  id                 String              @id @default(uuid())
  username           String              @db.VarChar(50)
  email              String              @unique @db.VarChar(70)
  passwordHash       String
  role               UserRole            @default(User)
  isEmailVerified    Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  bookings           Booking[]
  clientProfile      ClientProfile?
  emailVerifications EmailVerification[]
  favorites          Favorite[]
  idempotencyKeys    IdempotencyKey[]
  notifications      Notification[]
  offers             Offer[]
  sessions           UserSession[]

  @@map("users")
}
