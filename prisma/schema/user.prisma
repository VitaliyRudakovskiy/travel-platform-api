model User {
  id           String     @id @default(uuid())
  username     String     @db.VarChar(50)
  email        String     @unique @db.VarChar(70)
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  bookings     Booking[]
  favorites    Favorite[]
  offers       Offer[]

  @@map("users")
}
