// Transactional Outbox (spec 3.4): an event row is written in the same transaction as the booking change,
// and the outbox worker (stage III step 4) publishes it to RabbitMQ exchange `travel.events`.
// Prisma enum values can't contain a dot, so they are mapped to the event names in the database.
enum OutboxEventType {
  booking_created        @map("booking.created")
  booking_status_changed @map("booking.status_changed")
}

enum OutboxStatus {
  pending
  published
  failed
}

model OutboxEvent {
  id          String          @id @default(uuid()) // = eventId in the payload
  eventType   OutboxEventType @map("event_type")
  payload     Json
  status      OutboxStatus    @default(pending)
  // Not in the spec: lets the worker give up (status failed) after N publish attempts
  attempts    Int             @default(0)
  createdAt   DateTime        @default(now()) @map("created_at")
  publishedAt DateTime?       @map("published_at")

  @@index([status, createdAt])
  @@map("outbox_events")
}
